# ==============================================================================
# LocalLink Environment Configuration Example
# Copy this file to .env and set your local values.
# ==============================================================================

# --- Local Mesh & Engine Settings ---
LOCALLINK_NODE_ID=node_local_01
LOCALLINK_DISPLAY_NAME=Local User
LOCALLINK_HOST=0.0.0.0
LOCALLINK_PORT=5000
LOCALLINK_MDNS_SERVICE=_locallink._tcp.local.

# --- Storage & Database Settings ---
LOCALLINK_DB_PATH=locallink.db
LOCALLINK_KEYS_DIR=.keys

# --- Matrix Gateway Bridge Settings ---
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=@your_username:matrix.org
MATRIX_ACCESS_TOKEN=your_matrix_access_token_here
MATRIX_ROOM_ID=!your_room_id:matrix.org
MATRIX_SYNC_INTERVAL=10
